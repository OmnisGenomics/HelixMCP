{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provenance_run_id": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "bridge": {
      "type": "object",
      "properties": {
        "bridge_file": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "pid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "project_root": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bridge_file",
        "host",
        "port",
        "pid",
        "session_id",
        "started_at"
      ],
      "additionalProperties": false
    },
    "comparison_export": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "helix.studio.prime_comparison_export/v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "idle",
            "running",
            "complete",
            "failed"
          ]
        },
        "selected_run_id": {
          "type": "string"
        },
        "previous_run_id": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "receipt": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "helix.prime_comparison_export/v1"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "schema",
            "path",
            "sha256",
            "size_bytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "status"
      ],
      "additionalProperties": false
    },
    "comparison_artifact_id": {
      "type": "string",
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "comparison_checksum_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "log_artifact_id": {
      "type": "string",
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
    }
  },
  "required": [
    "provenance_run_id",
    "bridge",
    "comparison_export",
    "comparison_artifact_id",
    "comparison_checksum_sha256",
    "log_artifact_id"
  ],
  "additionalProperties": false,
  "$id": "helixmcp:tool:studio_prime_comparison_export:out:v1"
}
