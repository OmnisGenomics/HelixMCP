{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provenance_run_id": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "bridge": {
      "type": "object",
      "properties": {
        "bridge_file": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "pid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "project_root": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bridge_file",
        "host",
        "port",
        "pid",
        "session_id",
        "started_at"
      ],
      "additionalProperties": false
    },
    "prime_review": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "helix.studio.prime_results_review/v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "empty",
            "ready",
            "error"
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "compare_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_design": {
          "type": "boolean"
        },
        "full_sequence": {
          "type": "boolean"
        },
        "scroll_y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scroll_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "comparison": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "same_reference": {
                  "type": "boolean"
                },
                "sequence_comparable": {
                  "type": "boolean"
                },
                "different_offsets": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "model_changed": {
                  "type": "boolean"
                }
              },
              "required": [
                "same_reference",
                "sequence_comparable",
                "different_offsets",
                "reasons",
                "model_changed"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "selected_compatibility": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_compatibility": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "alignment": {
          "type": "string"
        },
        "integrity": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "status",
        "visible",
        "run_ids",
        "selected_run_id",
        "compare_run_id",
        "previous_design",
        "full_sequence",
        "scroll_y",
        "scroll_max"
      ],
      "additionalProperties": false
    },
    "log_artifact_id": {
      "type": "string",
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
    }
  },
  "required": [
    "provenance_run_id",
    "bridge",
    "prime_review",
    "log_artifact_id"
  ],
  "additionalProperties": false,
  "$id": "helixmcp:tool:studio_prime_results_review:out:v1"
}
