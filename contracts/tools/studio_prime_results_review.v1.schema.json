{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bridge_file": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "open",
        "select",
        "get_state"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "compare_run_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "full_sequence": {
      "type": "boolean"
    },
    "scroll_y": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "action"
  ],
  "additionalProperties": false,
  "$id": "helixmcp:tool:studio_prime_results_review:v1"
}
