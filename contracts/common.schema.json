{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helixmcp:common",
  "title": "HelixMCP Common Types",
  "type": "object",
  "$defs": {
    "Ulid26": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^proj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ArtifactId": {
      "type": "string",
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ArtifactType": {
      "type": "string",
      "enum": [
        "FASTQ_GZ",
        "BAM",
        "BAI",
        "VCF",
        "H5AD",
        "TSV",
        "CSV",
        "JSON",
        "ZIP",
        "MD",
        "TEXT",
        "HTML",
        "PDF",
        "PNG",
        "LOG",
        "UNKNOWN"
      ]
    },
    "StudioBridgeInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridge_file", "host", "port", "pid", "session_id", "started_at"],
      "properties": {
        "bridge_file": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "pid": { "type": "integer", "minimum": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "minLength": 1 },
        "project_root": { "type": "string", "minLength": 1 }
      }
    },
    "StudioVisualizationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "editor_profile",
        "repair_profile",
        "accessibility_profile",
        "selected_scale_id",
        "selected_outcome_label",
        "available_outcomes",
        "compare_loaded",
        "run_id",
        "run_label"
      ],
      "properties": {
        "mode": { "type": ["string", "null"], "enum": ["explore", "compare", "verify", null] },
        "editor_profile": { "type": ["string", "null"], "enum": ["spcas9", "hifi", "prime", null] },
        "repair_profile": { "type": ["string", "null"], "enum": ["balanced", "precise", "indel_bias", null] },
        "accessibility_profile": { "type": ["string", "null"], "enum": ["constrained", "baseline", "open", null] },
        "selected_scale_id": {
          "type": ["string", "null"],
          "enum": ["sequence", "complex", "cell", "tissue", "population", null]
        },
        "selected_outcome_label": { "type": ["string", "null"] },
        "available_outcomes": { "type": "array", "items": { "type": "string" } },
        "compare_loaded": { "type": "boolean" },
        "run_id": { "type": ["string", "null"] },
        "run_label": { "type": ["string", "null"] }
      }
    },
    "StudioState": {
      "type": "object",
      "additionalProperties": true,
      "required": ["current_tab", "available_tabs", "active_run_id", "project_root", "visualization"],
      "properties": {
        "current_tab": { "type": ["string", "null"] },
        "available_tabs": { "type": "array", "items": { "type": "string" } },
        "active_run_id": { "type": ["string", "null"] },
        "project_root": { "type": ["string", "null"] },
        "visualization": {
          "anyOf": [{ "$ref": "helixmcp:common#/$defs/StudioVisualizationState" }, { "type": "null" }]
        }
      }
    },
    "StudioScreenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "artifact_id",
        "format",
        "width_px",
        "height_px",
        "device_pixel_ratio",
        "size_bytes",
        "checksum_sha256",
        "captured_at"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "artifact_id": { "$ref": "helixmcp:common#/$defs/ArtifactId" },
        "format": { "const": "PNG" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "device_pixel_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "size_bytes": { "type": "string" },
        "checksum_sha256": { "$ref": "helixmcp:common#/$defs/Sha256" },
        "captured_at": { "type": "string", "minLength": 1 },
        "target": { "anyOf": [{ "type": "object", "additionalProperties": true }, { "type": "null" }] }
      }
    },
    "StudioPilotReviewState": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "integrity_verified": {
          "type": "boolean"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_state": {
          "type": "string",
          "enum": [
            "pending",
            "started",
            "finished"
          ]
        },
        "export_enabled": {
          "type": "boolean"
        },
        "exported_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "visible",
        "status",
        "integrity_verified",
        "candidate_count",
        "manifest_sha256",
        "observation_state",
        "export_enabled",
        "exported_path"
      ],
      "additionalProperties": false
    },
    "WorkflowEvaluationAnswers": {
      "additionalProperties": false,
      "properties": {
        "alternatives_considered": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "assumptions": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "change_explanation": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_rationale": {
          "type": "string"
        },
        "intent_to_export_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "manual_handoffs_removed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "return_visit": {
          "type": "boolean"
        },
        "schema": {
          "const": "helix.workflow_evaluation.answers.v1"
        },
        "selected_candidate_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tasks": {
          "additionalProperties": false,
          "properties": {
            "compare_candidates": {
              "additionalProperties": false,
              "properties": {
                "assistance_needed": {
                  "type": "boolean"
                },
                "notes": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "completed",
                    "blocked",
                    "skipped"
                  ]
                }
              },
              "required": [
                "status",
                "assistance_needed",
                "notes"
              ],
              "type": "object"
            },
            "explain_decision": {
              "additionalProperties": false,
              "properties": {
                "assistance_needed": {
                  "type": "boolean"
                },
                "notes": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "completed",
                    "blocked",
                    "skipped"
                  ]
                }
              },
              "required": [
                "status",
                "assistance_needed",
                "notes"
              ],
              "type": "object"
            },
            "inspect_assumptions": {
              "additionalProperties": false,
              "properties": {
                "assistance_needed": {
                  "type": "boolean"
                },
                "notes": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "completed",
                    "blocked",
                    "skipped"
                  ]
                }
              },
              "required": [
                "status",
                "assistance_needed",
                "notes"
              ],
              "type": "object"
            },
            "verify_package": {
              "additionalProperties": false,
              "properties": {
                "assistance_needed": {
                  "type": "boolean"
                },
                "notes": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "completed",
                    "blocked",
                    "skipped"
                  ]
                }
              },
              "required": [
                "status",
                "assistance_needed",
                "notes"
              ],
              "type": "object"
            }
          },
          "required": [
            "compare_candidates",
            "inspect_assumptions",
            "explain_decision",
            "verify_package"
          ],
          "type": "object"
        },
        "would_use_again": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "schema",
        "tasks",
        "selected_candidate_id",
        "alternatives_considered",
        "decision_rationale",
        "assumptions",
        "change_explanation",
        "intent_to_export_seconds",
        "manual_handoffs_removed",
        "return_visit",
        "would_use_again"
      ],
      "type": "object",
      "$comment": "Helix workflow_answers_v1 snapshot. SDK and published contracts preserve v1 fields; observations confer no approval."
    }
  }
}
